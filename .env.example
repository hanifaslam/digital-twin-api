# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# Auth Secrets (Recommended to use long random strings)
JWT_ACCESS_SECRET="ganti_dengan_access_secret_kamu"
JWT_REFRESH_SECRET="ganti_dengan_refresh_secret_kamu"

# Application Settings
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Redis Connection
REDIS_URL=redis://localhost:6379

# LLM Chatbot Configuration
LLAMA_API_URL=https://openrouter.ai/api/v1/chat/completions
LLAMA_API_KEY=
LLAMA_MODEL=meta-llama/llama-3.2-3b-instruct:free
LLAMA_PROVIDER_NAME=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
